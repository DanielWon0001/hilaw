---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
---

<BaseLayout title={`${article.data.title} - HiLaw`} description={article.data.excerpt}>
  <Header />

  <main class="main-content">
    <div class="container">
      <article class="article">
        <header class="article-header">
          <span class={`tag tag-${article.data.category}`}>{article.data.category}</span>
          <h1 class="article-title">{article.data.title}</h1>
          <div class="article-meta">
            <time class="article-date">{article.data.date}</time>
            {article.data.tags && article.data.tags.length > 0 && (
              <div class="article-tags">
                {article.data.tags.map(tag => (
                  <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">{tag}</a>
                ))}
              </div>
            )}
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>

        <!-- 评论 -->
        <div class="comment-section"><div class="commentbox"></div></div>
      </article>
    </div>
  </main>

  <Footer />

  <script src="https://unpkg.com/commentbox.io/dist/commentBox.min.js"></script>
  <script>commentBox('5721933932920832-proj');</script>
</BaseLayout>

<style>
  .main-content { padding-top: 64px; }
  .article { max-width: 800px; margin: 0 auto; padding: var(--space-12) var(--space-6); }
  .article-header { margin-bottom: var(--space-8); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .article-title { font-size: 2rem; margin: var(--space-4) 0; line-height: 1.3; font-family: var(--font-serif); }
  .article-meta { display: flex; align-items: center; gap: var(--space-4); color: var(--color-text-secondary); font-size: 0.9rem; margin-bottom: var(--space-4); }
  .article-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .article-body { font-size: 1.05rem; line-height: 1.8; color: var(--color-text); }
  .article-body :global(h2) { font-size: 1.6rem; margin: var(--space-8) 0 var(--space-4); font-family: var(--font-serif); }
  .article-body :global(h3) { font-size: 1.3rem; margin: var(--space-6) 0 var(--space-3); }
  .article-body :global(p) { margin-bottom: var(--space-4); }
  .article-body :global(pre) { background: #1a1a2e; color: #e0e0e0; padding: var(--space-4); border-radius: 8px; overflow-x: auto; font-size: 0.9rem; margin: var(--space-6) 0; }
  .article-body :global(code) { font-family: 'Fira Code', 'Consolas', monospace; font-size: 0.9em; }
  .article-body :global(blockquote) { border-left: 4px solid var(--color-primary); padding-left: var(--space-4); color: var(--color-text-secondary); margin: var(--space-6) 0; font-style: italic; }

  /* 评论区域 */
  .comment-section { margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-border); }

  /* Tag colors */
  .tag-刑事 { background: #FEE2E2; color: #991B1B; }
  .tag-民商 { background: #DBEAFE; color: #1E40AF; }
  .tag-知识产权 { background: #D1FAE5; color: #065F46; }
  .tag-涉外 { background: #FEF3C7; color: #92400E; }
  .tag-公司 { background: #E0E7FF; color: #3730A3; }
  .tag-互联网犯罪 { background: #F3E8FF; color: #6B21A8; }
  .tag-刑事辩护 { background: #FEE2E2; color: #991B1B; }
  .tag-医疗纠纷 { background: #D1FAE5; color: #065F46; }
  .tag-热点评论 { background: #FEF3C7; color: #92400E; }
  .tag-医疗 { background: #D1FAE5; color: #065F46; }
</style>
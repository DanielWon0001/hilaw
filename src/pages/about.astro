---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { name: '刑事', slug: 'criminal' },
  { name: '民商', slug: 'civil' },
  { name: '知识产权', slug: 'ip' },
  { name: '涉外', slug: 'international' },
  { name: '公司', slug: 'corporate' },
  { name: '互联网', slug: 'internet' },
  { name: '人工智能', slug: 'ai' },
  { name: 'Web3', slug: 'web3' },
  { name: '虚拟货币', slug: 'crypto' },
];
---

<BaseLayout title="关于 - HiLaw" description="联系律师">
  <Header />
  <main class="main-content">
    <section class="page-hero">
      <div class="container">
        <h1 class="page-title">关于</h1>
      </div>
    </section>
    <div class="container contact-section">
      <div class="contact-card">
        <h2 class="contact-name">王立东</h2>
        <p class="contact-desc">北京志霖律师事务所合伙人律师</p>
        <div class="contact-list">
          <div class="contact-item">
            <span class="contact-label">邮箱</span>
            <a href="mailto:lawyer@lawmore.cn" class="contact-value">lawyer@lawmore.cn</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">微信</span>
            <span class="contact-value">lawmore_cn</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">电话</span>
            <a href="tel:+8613912345678" class="contact-value">139-1234-5678</a>
          </div>
        </div>
        <div class="categories-section">
          <h3 class="categories-title">专业领域</h3>
          <div class="categories-grid">
            {categories.map(cat => (
              <a href={`/articles/${cat.slug}`} class="category-chip">{cat.name}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .main-content { padding-top: 64px; }
  .page-hero { background: linear-gradient(135deg, var(--color-primary) 0%, #1a3db8 100%); padding: var(--space-12) 0; text-align: center; }
  .page-title { font-family: var(--font-serif); font-size: 2.5rem; color: white; }
  .contact-section { max-width: 600px; margin: 0 auto; padding: var(--space-12) var(--space-6); }
  .contact-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-12); text-align: center; }
  .contact-name { font-family: var(--font-serif); font-size: 2rem; margin-bottom: var(--space-2); }
  .contact-desc { color: var(--color-text-secondary); margin-bottom: var(--space-8); font-size: 1rem; }
  .contact-list { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-8); text-align: left; }
  .contact-item { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
  .contact-item:last-child { border-bottom: none; }
  .contact-label { font-size: 0.85rem; color: var(--color-text-secondary); min-width: 50px; font-weight: 500; }
  .contact-value { color: var(--color-primary); font-size: 0.95rem; }
  .contact-value:hover { text-decoration: underline; }
  .categories-section { border-top: 1px solid var(--color-border); padding-top: var(--space-8); }
  .categories-title { font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: var(--space-4); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-sans); font-weight: 600; }
  .categories-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .category-chip { padding: var(--space-2) var(--space-4); background: var(--color-tag-bg); border-radius: 20px; font-size: 0.85rem; color: var(--color-text); transition: background var(--transition-fast); }
  .category-chip:hover { background: var(--color-primary-light); color: var(--color-primary); }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const allLaws = await getCollection('laws');
const allCases = await getCollection('cases');
const allArticles = await getCollection('articles');

const recentNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 2);
const recentLaws = allLaws.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 2);
const recentCases = allCases.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 2);
const recentArticles = allArticles.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 2);

const allTags = [...allNews, ...allLaws, ...allCases].flatMap(item => item.data.tags);
const tagCounts: Record<string, number> = {};
allTags.forEach(tag => { tagCounts[tag] = (tagCounts[tag] || 0) + 1; });
const topTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 20);
---

<BaseLayout title="HiLaw - 法律新闻 · 专业评论 · 新法解读" description="法律新闻 · 专业评论 · 新法解读">
  <Header />

  <main class="main-content">
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-brand">
            <span class="hero-logo-text">HiLaw</span>
            <span class="hero-tagline">法律新闻 · 专业评论 · 新法解读</span>
          </div>
          <p class="hero-description">一个温暖的法律信息空间，在这里，复杂的法律问题被平实地讲述。</p>
        </div>
      </div>
    </section>

    <div class="container content-grid">
      <aside class="sidebar">
        <CategoryNav />
        <div class="tag-cloud">
          <h4 class="tag-cloud-title">标签云</h4>
          <div class="tags">
            {topTags.map(([tag, count]) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag" style={`font-size: ${0.8 + count * 0.05}rem`}>
                {tag}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="main-feed">
        {recentNews.length > 0 && (
          <section class="feed-section">
            <div class="section-header">
              <h2 class="section-title">热点新闻</h2>
              <a href="/news" class="section-more">查看全部 →</a>
            </div>
            <div class="news-list">
              {recentNews.map(news => (
                <NewsCard
                  title={news.data.title}
                  excerpt={news.data.excerpt}
                  date={news.data.date}
                  category={news.data.category}
                  tags={news.data.tags}
                  source={news.data.source}
                  href={`/news/${news.slug}`}
                  type="news"
                />
              ))}
            </div>
          </section>
        )}

        {recentLaws.length > 0 && (
          <section class="feed-section">
            <div class="section-header">
              <h2 class="section-title">新法推送</h2>
              <a href="/laws" class="section-more">查看全部 →</a>
            </div>
            <div class="news-list">
              {recentLaws.map(law => (
                <NewsCard
                  title={law.data.title}
                  excerpt={law.data.excerpt}
                  date={law.data.date}
                  category={law.data.category}
                  tags={law.data.tags}
                  href={`/laws/${law.slug}`}
                  type="law"
                />
              ))}
            </div>
          </section>
        )}

        {recentCases.length > 0 && (
          <section class="feed-section">
            <div class="section-header">
              <h2 class="section-title">典型案例</h2>
              <a href="/cases" class="section-more">查看全部 →</a>
            </div>
            <div class="news-list">
              {recentCases.map(caseItem => (
                <NewsCard
                  title={caseItem.data.title}
                  excerpt={caseItem.data.excerpt}
                  date={caseItem.data.date}
                  category={caseItem.data.category}
                  tags={caseItem.data.tags}
                  source={caseItem.data.source}
                  href={`/cases/${caseItem.slug}`}
                  type="case"
                />
              ))}
            </div>
          </section>
        )}

        {recentArticles.length > 0 && (
          <section class="feed-section">
            <div class="section-header">
              <h2 class="section-title">最新文章</h2>
              <a href="/articles" class="section-more">查看全部 →</a>
            </div>
            <div class="news-list">
              {recentArticles.map(article => (
                <ArticleCard
                  title={article.data.title}
                  excerpt={article.data.excerpt}
                  date={article.data.date}
                  category={article.data.category}
                  tags={article.data.tags}
                  href={`/articles/${article.slug}`}
                  type="article"
                />
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
---
export interface Props {
  title: string;
  excerpt?: string;
  date: string;
  category: string;
  tags?: string[];
  href: string;
  isExternal?: boolean;
}
const { title, excerpt, date, category, tags = [], href, isExternal = false } = Astro.props;
const categoryClass = `tag${category}`;
---

<a href={href} class={`article-card fade-up ${isExternal ? 'external' : ''}`} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
  <div class="card-meta">
    <span class={`tag ${categoryClass}`}>{category}</span>
    <time class="card-date">{date}</time>
    {isExternal && <span class="external-badge">原文 ↗</span>}
  </div>
  <h3 class="card-title">{title}</h3>
  {excerpt && <p class="card-excerpt">{excerpt}</p>}
  {tags.length > 0 && (
    <div class="card-tags">
      {tags.slice(0, 3).map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .article-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    text-decoration: none;
  }

  .article-card:hover {
    transform: scale(1.01);
    box-shadow: var(--shadow-md);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-date {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .card-title {
    font-size: 1.15rem;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .card-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .external-badge {
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 500;
    margin-left: auto;
  }

  /* Tag colors */
  :global(.tag刑事) { background: #FEE2E2; color: #991B1B; }
  :global(.tag民商) { background: #DBEAFE; color: #1E40AF; }
  :global(.tag知产) { background: #D1FAE5; color: #065F46; }
  :global(.tag涉外) { background: #FEF3C7; color: #92400E; }
  :global(.tag互联网犯罪) { background: #F3E8FF; color: #6B21A8; }
  :global(.tag刑事辩护) { background: #FEE2E2; color: #991B1B; }
  :global(.tag医疗纠纷) { background: #D1FAE5; color: #065F46; }
  :global(.tag热点评论) { background: #FEF3C7; color: #92400E; }
</style>
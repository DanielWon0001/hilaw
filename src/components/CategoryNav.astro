---
const categories = [
  { name: '刑事', slug: 'criminal' },
  { name: '民商', slug: 'civil' },
  { name: '知识产权', slug: 'ip' },
  { name: '涉外', slug: 'international' },
  { name: '公司', slug: 'corporate' },
  { name: '互联网', slug: 'internet' },
  { name: '人工智能', slug: 'ai' },
  { name: 'Web3', slug: 'web3' },
  { name: '虚拟货币', slug: 'crypto' },
];

export interface Props {
  activeSlug?: string;
}
const { activeSlug } = Astro.props;
---

<nav class="category-nav">
  <h4 class="nav-title">分类</h4>
  <ul class="nav-list">
    {categories.map(cat => (
      <li>
        <a
          href={`/articles/${cat.slug}`}
          class={`nav-item ${activeSlug === cat.slug ? 'active' : ''}`}
        >
          {cat.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .category-nav {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
  }

  .nav-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-item {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: 6px;
    font-size: 0.95rem;
    color: var(--color-text);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .nav-item:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .nav-item.active {
    background: var(--color-primary);
    color: white;
    font-weight: 500;
  }
</style>